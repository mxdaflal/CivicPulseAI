# Development/staging Supabase project only. Browser-exposed key must be public/anon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional canonical browser origin for a TLS-terminating proxy; actual site origin only.
CIVICPULSE_APP_ORIGIN=
# Optional anonymous text reporting: all settings are required together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
REPORT_RATE_LIMIT_SECRET=
# Name of a header your hosting platform strips/replaces, e.g. Netlify's x-nf-client-connection-ip.
# Never accept a caller-controlled header. Leave blank to disable anonymous submissions.
CIVICPULSE_TRUSTED_IP_HEADER=
# OPENAI_API_KEY belongs in the Supabase Edge Function secret store, not this browser app.
